{
  "name": "graft-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/embed-assets.mjs",
    "check": "tsc --noEmit",
    "test:tree": "node --experimental-strip-types --test tests/tree-nodes.test.ts",
    "test:table": "node --experimental-strip-types --test tests/table-pages.test.ts",
    "test:table:browser": "node tests/table.browser.mjs",
    "test:preferences": "node --experimental-strip-types --test tests/preferences.test.ts",
    "test:database": "node --experimental-strip-types --test tests/database-reads.test.ts",
    "test:diff": "node --experimental-strip-types --test tests/diff-columns.test.ts",
    "test:merge": "node --experimental-strip-types --test tests/text-merge.test.ts",
    "test:conflicts": "node --experimental-strip-types --test tests/database-conflict-rows.test.ts"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "lodash": "4.18.1",
    "marked": "4.3.0",
    "node-diff3": "3.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-responsive-carousel": "3.2.23"
  },
  "devDependencies": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
